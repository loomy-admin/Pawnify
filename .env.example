# ==============================================================================
# PAWNIFY PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# NEVER commit real credentials or .env / .env.local files to source control.
# ==============================================================================

# ---- DATABASE (MySQL / Amazon RDS / PlanetScale / Self-hosted) ----
# DATABASE_URL: Standard MySQL connection URI used by Sequelize & Better Auth.
# (Server-only | Required in Production / Preview / Development)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/pawnify_db"

# Or individual MySQL connection parameters:
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_DATABASE="pawnify_db"

# Optional max pool size per runtime container (default: 10)
DB_POOL_MAX="10"

# ---- BETTER AUTH ----
# BETTER_AUTH_SECRET: High-entropy secret key for signing session tokens (min 32 chars).
# Generate with: openssl rand -base64 32
# (Server-only | Required in Production / Preview)
BETTER_AUTH_SECRET="your-32-char-minimum-production-auth-secret"

# BETTER_AUTH_URL: Public canonical URL of the deployed application.
# (Server-only | Required in Production, e.g. https://pawnify.vercel.app)
BETTER_AUTH_URL="https://your-pawnify-deployment.vercel.app"

# ---- APPLICATION / CLIENT CONFIGURATION ----
# NEXT_PUBLIC_APP_URL: Public client-side origin for metadata and client auth.
# (Public / Client-safe | Required in Production)
NEXT_PUBLIC_APP_URL="https://your-pawnify-deployment.vercel.app"

# ---- VERCEL CRON JOBS ----
# CRON_SECRET: Bearer authorization secret securing /api/cron/update-rates.
# (Server-only | Required in Production for Vercel Cron invocation)
CRON_SECRET="your-strong-random-cron-secret-token"

# ---- OPTIONAL: STORAGE (Supabase Storage for customer KYC documents & photos) ----
# If using Supabase Storage for customer document upload:
# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---- SYSTEM LOGGING ----
# Set to "true" only when verbose interest/waterfall calculation tracing is required.
DEBUG="false"
